<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cluster Node: {{ inventory_hostname }}</title>
    <style>
        body { font-family: sans-serif; background-color: #f4f7f6; text-align: center; padding-top: 50px; }
        .card { background: white; padding: 40px; margin: auto; border-radius: 10px; max-width: 400px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); border-top: 5px solid #28a745; }
        h1 { color: #333; }
        .val { font-weight: bold; color: #007bff; font-size: 1.2em; }
    </style>
</head>
<body>
    <div class="card">
        <h1>🚀 Serving from Ansible Role</h1>
        <p>Node Name: <span class="val">{{ inventory_hostname }}</span></p>
        <p>Node IP: <span class="val">{{ ansible_default_ipv4.address }}</span></p>
    </div>
</body>
</html>
